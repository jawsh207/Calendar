<?xml version="1.0" encoding="utf-8"?>
<!-- Events live in Android's calendar storage, not the app, and travel with the accounts that
     hold them. Only the app's own settings are backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
