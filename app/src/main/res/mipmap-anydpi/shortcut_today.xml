<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher shortcut icon: the today glyph in white on the app icon's cranberry red, so the
     shortcuts read as part of Calendar. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/shortcut_today_glyph" />
    <monochrome android:drawable="@drawable/shortcut_today_glyph" />
</adaptive-icon>
