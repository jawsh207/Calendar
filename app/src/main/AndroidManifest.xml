<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Events live in Android's shared calendar storage, which every calendar app reads and
         writes; these two let the app do the same. Notifications are for event reminders. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- After the phone restarts, sets the widgets' storage watch and midnight alarm up again;
         Android forgets both on restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Calendar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_CALENDAR" />
            </intent-filter>
            <!-- Long-press shortcuts on the launcher icon: New event, Search and Today. -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <!-- Another app opening one event (content://com.android.calendar/events/<id>). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/event" />
            </intent-filter>
            <!-- Another app opening the calendar at a time (content://com.android.calendar/time/<ms>). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:host="com.android.calendar" android:mimeType="time/epoch" />
            </intent-filter>
            <!-- Another app asking for a new event, or to edit one. -->
            <intent-filter>
                <action android:name="android.intent.action.INSERT" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/event" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.INSERT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/event" />
            </intent-filter>
        </activity>

        <!-- The calendar storage sends this when an event's reminder is due. It's one of the
             broadcasts Android still delivers to apps that aren't running. -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.EVENT_REMINDER" />
                <data android:scheme="content" android:host="com.android.calendar" />
            </intent-filter>
        </receiver>

        <!-- Home screen widgets: the Agenda list and the Month grid. -->
        <receiver
            android:name=".widgets.AgendaWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_agenda_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/agenda_widget_info" />
        </receiver>
        <receiver
            android:name=".widgets.MonthWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_month_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/month_widget_info" />
        </receiver>

        <!-- Redraws the widgets whenever the calendar storage changes. -->
        <service
            android:name=".widgets.CalendarChangeJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Redraws the widgets at midnight and when the clock, time zone or language changes,
             and sets their updates up again after a restart or an app update. These system broadcasts are among
             the few Android still delivers to apps that aren't running. -->
        <receiver
            android:name=".widgets.WidgetClockReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
