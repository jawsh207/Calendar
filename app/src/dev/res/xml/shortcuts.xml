<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher's long-press shortcuts. Test builds' copy: the same as src/main/res/xml/shortcuts.xml but for the test build's app id. Keep the two the same apart from the id. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_event"
        android:icon="@mipmap/shortcut_add"
        android:shortcutShortLabel="@string/new_event"
        android:shortcutLongLabel="@string/new_event">
        <!-- The same request another app makes to add an event. -->
        <intent
            android:action="android.intent.action.INSERT"
            android:data="content://com.android.calendar/events"
            android:targetPackage="app.agenda.calendar.dev"
            android:targetClass="app.agenda.calendar.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="search"
        android:icon="@mipmap/shortcut_search"
        android:shortcutShortLabel="@string/shortcut_search"
        android:shortcutLongLabel="@string/search_events">
        <intent
            android:action="app.agenda.calendar.action.SEARCH"
            android:targetPackage="app.agenda.calendar.dev"
            android:targetClass="app.agenda.calendar.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="today"
        android:icon="@mipmap/shortcut_today"
        android:shortcutShortLabel="@string/today"
        android:shortcutLongLabel="@string/shortcut_today_long">
        <intent
            android:action="app.agenda.calendar.action.TODAY"
            android:targetPackage="app.agenda.calendar.dev"
            android:targetClass="app.agenda.calendar.MainActivity" />
    </shortcut>
</shortcuts>
